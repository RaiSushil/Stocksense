# Copy to .env. The Shopify CLI (npm run dev) injects SHOPIFY_API_KEY, SHOPIFY_API_SECRET,
# SHOPIFY_APP_URL and SCOPES automatically in development; set them yourself in production.

# Database. SQLite for development. For production use PostgreSQL:
# change provider to "postgresql" in prisma/schema.prisma and set a postgres:// URL.
DATABASE_URL="file:./dev.sqlite"

# Shopify (production)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://stocksense.example.com
SCOPES=read_products,read_inventory,write_inventory,read_locations,read_orders,read_all_orders,read_inventory_transfers,write_inventory_transfers
# App handle from shopify.app.toml, used to build links back into the Shopify admin
SHOPIFY_APP_HANDLE=stocksense

# Billing: test charges (no real money). Always true outside production.
BILLING_TEST=true
# Development only: skip Billing and act as this plan (LAUNCH, SCALE or PRO)
# STOCKSENSE_DEV_PLAN=PRO
# Allow "Load demo data" in production builds (staging stores only)
# STOCKSENSE_ALLOW_DEMO=true

# Ask StockSense (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Email alerts and supplier POs (any SMTP provider)
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="StockSense <alerts@stocksense.example.com>"

# Scheduler. Leave unset to run the in-process scheduler (single instance).
# With several instances: DISABLE_SCHEDULER=true on all of them and call
# POST /jobs/tick with "Authorization: Bearer $CRON_SECRET" every 5 minutes.
# DISABLE_SCHEDULER=true
CRON_SECRET=

# SMS and WhatsApp alerts through Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Twilio sandbox only: the "join ..." phrase merchants send once
TWILIO_WHATSAPP_JOIN_CODE=

# WhatsApp assistant through the WhatsApp Cloud API (real buttons and lists).
# Without these, the assistant uses Twilio and shows numbered options instead.
# Webhook URL to set in Meta: <SHOPIFY_APP_URL>/webhooks/whatsapp
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_APP_SECRET=
META_WA_VERIFY_TOKEN=
META_WA_BUSINESS_NUMBER=
# Approved template with one body variable, for alerts outside the 24-hour window
META_WA_ALERT_TEMPLATE=
META_WA_ALERT_TEMPLATE_LANG=en
